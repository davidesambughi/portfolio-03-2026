      "updated": 1775473807976,
      "link": null,
      "locked": false,
      "text": "5. Stripe Webhook → Route Handler (/api/stripe)\n  a) Verify signature\n  b) Idempotency: INSERT ... ON CONFLICT DO NOTHING\n  c) Guard: order must be pending_payment\n  d) Validate amount",
      "fontSize": 13,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "s5",
      "originalText": "5. Stripe Webhook → Route Handler (/api/stripe)\n  a) Verify signature\n  b) Idempotency: INSERT ... ON CONFLICT DO NOTHING\n  c) Guard: order must be pending_payment\n  d) Validate amount",
      "autoResize": true,
      "lineHeight": 1.25
    },
